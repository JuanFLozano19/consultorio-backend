# ============================================
# Plantilla de Variables de Entorno - Consultorio Backend
# ============================================
# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO se sube a GitHub.
# ============================================

# ===== Base de Datos (Supabase o PostgreSQL local) =====
DB_URL=jdbc:postgresql://localhost:5432/consultorio
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ===== JWT =====
# Mínimo 32 caracteres. Genera una con: openssl rand -base64 48
JWT_SECRET=<clave-secreta-larga-para-HS256>
JWT_EXPIRATION=28800000

# ===== Servidor =====
SERVER_PORT=8080

# ===== CORS (URL del frontend; varias separadas por coma) =====
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ===== Administrador inicial (doctor o secretaria) =====
ADMIN_NOMBRE=Dr. Jeison Patiño
ADMIN_CORREO=admin@ejemplo.com
ADMIN_PASSWORD=<contraseña-segura>

# ===== Formulario público =====
CITAS_LIMITE_POR_HORA=5

# ===== Aviso por correo de nuevas solicitudes (opcional) =====
NOTIFICACION_CORREO=
MAIL_USERNAME=
MAIL_PASSWORD=
